# MUETY E-Commerce Platform Configuration Boundary

# ==============================================================================
# 1. CLIENT FRONTEND CONFIGURATION (Browser-Safe / Prefixed with VITE_)
# ==============================================================================
# Required for Firebase Client SDK (Auth, Firestore, Hosting):
VITE_FIREBASE_API_KEY=AIzaSyYourLiveFirebaseApiKeyHere
VITE_FIREBASE_AUTH_DOMAIN=your-firebase-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=muetystore-fdad2
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890

# OPTIONAL / UNUSED: Firebase Cloud Storage is NOT provisioned for MUETY.
# All media assets are managed via Cloudinary or verified static/HTTPS URLs.
# Storage provisioning is not required for build, startup, or deployment.
# VITE_FIREBASE_STORAGE_BUCKET=your-firebase-project.firebasestorage.app

# Required for Razorpay Storefront Payment Gateway:
VITE_RAZORPAY_KEY_ID=rzp_test_YourRazorpayKeyIdHere

# Cloudinary Public Configuration (Optional - only if media uploads are enabled):
# Browser-safe identifiers only:
VITE_CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
VITE_CLOUDINARY_SIGNATURE_ENDPOINT=/api/media/cloudinary-signature

# ==============================================================================
# 2. SERVER PRIVILEGED BACKEND CREDENTIALS (NEVER EXPOSE IN CLIENT BUNDLE)
# ==============================================================================
# Razorpay Server Verification (Required for server-side payment signature verification):
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Cloudinary Server Media Management (Optional - only required if admin media uploads are configured):
# If unconfigured, existing images continue to render and uploads show clear actionable message.
# NEVER prefix with VITE_ or expose in browser code:
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Firebase Admin SDK Credentials (Required for privileged server APIs, role assignment, customer sync):
# Option A: Service account file path:
FIREBASE_PROJECT_ID=muetystore-fdad2
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
# Option B: Direct environment credentials (Alternative to file path):
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxx@muetystore-fdad2.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Email Infrastructure (Resend API - Separate functional senders):
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_FROM_EMAIL=MUETY Admin <admin@muety.in>
RESEND_ADMIN_FROM_EMAIL=MUETY Admin <admin@muety.in>
RESEND_ORDERS_FROM_EMAIL=MUETY Orders <orders@muety.in>
RESEND_MARKETING_FROM_EMAIL=MUETY Promotions <promotions@muety.in>
RESEND_REPLY_TO_EMAIL=support@muety.in
EMAIL_UNSUBSCRIBE_SECRET=your_secure_unsubscribe_secret_token

# Admin Provisioning & Security
BOOTSTRAP_ADMIN_EMAIL=admin@muety.in
BOOTSTRAP_ADMIN_PASSWORD=

# MUETY Admin ERP Production Domain Configuration
VITE_ADMIN_APP_URL=https://admin.muety.in
ADMIN_APP_URL=https://admin.muety.in

# Launch Gateway Configuration
LAUNCH_DATE=2026-11-01T08:00:00+05:30
LAUNCH_ESTABLISHMENT=2026
MUETY_LAUNCH_MODE=production
MUETY_STORE_URL=https://store.muety.in

# Local Firebase Emulator Configuration (Optional - for local testing only)
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099



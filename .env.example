# MUETY E-Commerce Platform Configuration Boundary

# Client Frontend Public Configuration (Browser Readable)
VITE_FIREBASE_API_KEY=AIzaSyYourLiveFirebaseApiKeyHere
VITE_FIREBASE_AUTH_DOMAIN=your-firebase-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-firebase-project
VITE_FIREBASE_STORAGE_BUCKET=your-firebase-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890
VITE_RAZORPAY_KEY_ID=rzp_test_YourRazorpayKeyIdHere

# Client-Safe Public Media Identifiers Only
VITE_CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
VITE_CLOUDINARY_SIGNATURE_ENDPOINT=/api/cloudinary/sign

# Server-Only Privileged Credentials (DO NOT prefix with VITE_ / NEVER expose in client bundle)
# Razorpay Backend Verification Secret
RAZORPAY_KEY_SECRET=YourRazorpaySecretKeyHere

# Cloudinary Server Media Management
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=YourCloudinaryApiKeyHere
CLOUDINARY_API_SECRET=YourCloudinaryApiSecretHere

# Firebase Admin SDK Configuration (Choose Either Service Account Path OR Client Email + Private Key)
FIREBASE_PROJECT_ID=your-firebase-project
GOOGLE_APPLICATION_CREDENTIALS=/path/to/firebase-service-account.json
# Alternative to JSON file:
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-firebase-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQD...\n-----END PRIVATE KEY-----\n"

# Admin Invitation & Transactional Email Service (Resend)
RESEND_API_KEY=re_YourResendApiKeyHere
RESEND_FROM_EMAIL="MUETY Admin <admin@muety.in>"

# Admin Provisioning & Security
BOOTSTRAP_ADMIN_EMAIL=superadmin@muety.in
BOOTSTRAP_ADMIN_PASSWORD=YourSecureServerAdminPasswordHere

# MUETY Admin ERP Production Domain Configuration
VITE_ADMIN_APP_URL=https://www.admin.muety.in
ADMIN_APP_URL=https://www.admin.muety.in

# Local Firebase Emulator Configuration (Optional - for local testing only)
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099


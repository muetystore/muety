rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    function isSignedIn() {
      return request.auth != null;
    }

    function getRoles() {
      return isSignedIn() && request.auth.token.keys().hasAll(['roles'])
        ? request.auth.token.roles
        : (isSignedIn() && request.auth.token.keys().hasAll(['role'])
            ? [request.auth.token.role]
            : []);
    }

    function isCatalogManager() {
      return getRoles().hasAny(['super_admin', 'admin', 'catalog_manager']);
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isImage() {
      return request.resource.contentType.matches('image/.*');
    }

    function isValidSize() {
      return request.resource.size < 5 * 1024 * 1024; // Maximum 5 MB limit
    }

    // Product media: public read, authorized catalog manager write with MIME & size validation
    match /products/{allPaths=**} {
      allow read: if true;
      allow write: if isCatalogManager() && isImage() && isValidSize();
    }

    // Category media: public read, authorized catalog manager write with MIME & size validation
    match /categories/{allPaths=**} {
      allow read: if true;
      allow write: if isCatalogManager() && isImage() && isValidSize();
    }

    // User avatar/profile media: public read, owner or catalog manager write with MIME & size validation
    match /users/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if (isOwner(userId) || isCatalogManager()) && isImage() && isValidSize();
    }

    // Default catch-all: strict write controls
    match /{allPaths=**} {
      allow read: if true;
      allow write: if isCatalogManager() && isImage() && isValidSize();
    }
  }
}

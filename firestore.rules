rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- Helper Functions ---
    function isSignedIn() {
      return request.auth != null;
    }

    function getRoles() {
      return isSignedIn() && request.auth.token.keys().hasAll(['roles'])
        ? request.auth.token.roles
        : (isSignedIn() && request.auth.token.keys().hasAll(['role'])
            ? [request.auth.token.role]
            : []);
    }

    function hasRole(targetRole) {
      return targetRole in getRoles();
    }

    function hasAnyRole(targetRoles) {
      return getRoles().hasAny(targetRoles);
    }

    function isSuperAdmin() {
      return hasRole('super_admin');
    }

    function isAdmin() {
      return hasAnyRole(['super_admin', 'admin']);
    }

    function isCatalogManager() {
      return hasAnyRole(['super_admin', 'admin', 'catalog_manager']);
    }

    function isOrderManager() {
      return hasAnyRole(['super_admin', 'admin', 'order_manager']);
    }

    function isSupportAgent() {
      return hasAnyRole(['super_admin', 'admin', 'support_agent']);
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Products Collection
    match /products/{productId} {
      allow read: if true;
      allow write: if isCatalogManager();
    }

    // Categories Collection
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isCatalogManager();
    }

    // Coupons Collection
    match /coupons/{couponId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Store Settings
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // User Profiles Collection
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin() || isSupportAgent() || isOrderManager();
      allow create: if isSignedIn() && (!request.resource.data.keys().hasAll(['roles']) || isAdmin());
      allow update: if isOwner(userId) 
        ? (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['roles', 'role', 'isBlocked']))
        : isAdmin();
      allow delete: if isSuperAdmin();
    }

    // Orders Collection
    match /orders/{orderId} {
      allow read: if isOrderManager() || (isSignedIn() && resource.data.customerId == request.auth.uid);
      allow create: if true; // Public guest/patron checkout
      allow update, delete: if isOrderManager();
    }

    // Patron Reviews Collection
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isSupportAgent();
    }

    // Inquiries Collection
    match /inquiries/{inquiryId} {
      allow create: if true; // Public contact form submission
      allow read, update, delete: if isSupportAgent();
    }
  }
}

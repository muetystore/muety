rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- HELPER FUNCTIONS ---
    function isSignedIn() {
      return request.auth != null;
    }

    function getRoles() {
      return isSignedIn()
        ? (
            ('roles' in request.auth.token && request.auth.token.roles is list && request.auth.token.roles.size() > 0)
              ? request.auth.token.roles
              : (('role' in request.auth.token && request.auth.token.role is string && request.auth.token.role.size() > 0)
                  ? [request.auth.token.role]
                  : (exists(/databases/$(database)/documents/admins/$(request.auth.uid))
                      ? (
                          ('roles' in get(/databases/$(database)/documents/admins/$(request.auth.uid)).data && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.roles is list && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.roles.size() > 0)
                            ? get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.roles
                            : (('role' in get(/databases/$(database)/documents/admins/$(request.auth.uid)).data && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role is string && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role.size() > 0)
                                ? [get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role]
                                : (exists(/databases/$(database)/documents/users/$(request.auth.uid))
                                    ? (
                                        ('roles' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.roles is list && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.roles.size() > 0)
                                          ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.roles
                                          : (('role' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role is string && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role.size() > 0)
                                              ? [get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role]
                                              : (('email' in request.auth.token && request.auth.token.email is string && request.auth.token.email.lower() in ['superadmin@muety.in', 'admin@muety.in', 'catalog@muety.in', 'kalvi@muety.in', 'mohan.admin@muety.in', 'vignesh.admin@muety.in'] || request.auth.token.email.lower().matches('.*\\.admin@muety\\.in'))
                                                  ? ['superadmin', 'admin', 'catalog_manager', 'order_manager']
                                                  : [])
                                            )
                                      )
                                    : (('email' in request.auth.token && request.auth.token.email is string && request.auth.token.email.lower() in ['superadmin@muety.in', 'admin@muety.in', 'catalog@muety.in', 'kalvi@muety.in', 'mohan.admin@muety.in', 'vignesh.admin@muety.in'] || request.auth.token.email.lower().matches('.*\\.admin@muety\\.in'))
                                        ? ['superadmin', 'admin', 'catalog_manager', 'order_manager']
                                        : [])
                                  )
                              )
                        )
                      : (exists(/databases/$(database)/documents/users/$(request.auth.uid))
                          ? (
                              ('roles' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.roles is list && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.roles.size() > 0)
                                ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.roles
                                : (('role' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role is string && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role.size() > 0)
                                    ? [get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role]
                                    : (('email' in request.auth.token && request.auth.token.email is string && request.auth.token.email.lower() in ['superadmin@muety.in', 'admin@muety.in', 'catalog@muety.in', 'kalvi@muety.in', 'mohan.admin@muety.in', 'vignesh.admin@muety.in'] || request.auth.token.email.lower().matches('.*\\.admin@muety\\.in'))
                                        ? ['superadmin', 'admin', 'catalog_manager', 'order_manager']
                                        : [])
                                  )
                            )
                          : (('email' in request.auth.token && request.auth.token.email is string && request.auth.token.email.lower() in ['superadmin@muety.in', 'admin@muety.in', 'catalog@muety.in', 'kalvi@muety.in', 'mohan.admin@muety.in', 'vignesh.admin@muety.in'] || request.auth.token.email.lower().matches('.*\\.admin@muety\\.in'))
                              ? ['superadmin', 'admin', 'catalog_manager', 'order_manager']
                              : [])
                        )
                    )
              )
        )
    : [];
    }

    function hasRole(targetRole) {
      return targetRole in getRoles();
    }

    function hasAnyRole(targetRoles) {
      return getRoles().hasAny(targetRoles);
    }

    function isSuperAdmin() {
      return hasAnyRole(['superadmin', 'super_admin']);
    }

    function isAdmin() {
      return hasAnyRole(['superadmin', 'super_admin', 'admin']);
    }

    function isCatalogManager() {
      return hasAnyRole(['superadmin', 'super_admin', 'admin', 'catalog_manager']);
    }

    function isOrderManager() {
      return hasAnyRole(['superadmin', 'super_admin', 'admin', 'order_manager']);
    }

    function isSupportManager() {
      return hasAnyRole(['superadmin', 'super_admin', 'admin', 'support_manager', 'support_agent']);
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // --- USERS COLLECTION ---
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin() || isSupportManager() || isOrderManager();
      allow create: if (
        isOwner(userId) &&
        (!('uid' in request.resource.data) || request.resource.data.uid == request.auth.uid) &&
        !request.resource.data.keys().hasAny([
          'roles', 'role', 'roleId', 'roleSlug', 'roleName', 
          'departmentId', 'departmentName', 'department', 
          'permissions', 'status', 'invitationStatus', 'isBlocked', 'customerStatus',
          'ordersCount', 'totalSpent'
        ])
      ) || isAdmin();
      allow update: if isOwner(userId) 
        ? (!request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'roles', 'role', 'roleId', 'roleSlug', 'roleName', 
            'departmentId', 'departmentName', 'department', 
            'permissions', 'status', 'invitationStatus', 'isBlocked', 'customerStatus',
            'ordersCount', 'totalSpent', 'uid', 'createdAt'
          ]))
        : (isSupportManager() || isAdmin());
      allow delete: if isSuperAdmin();
    }

    // --- DEPARTMENTS COLLECTION ---
    match /departments/{departmentId} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin();
    }

    // --- ROLES COLLECTION ---
    match /roles/{roleId} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin();
    }

    // --- ADMINS COLLECTION ---
    match /admins/{adminId} {
      allow read: if isAdmin();
      allow write: if isSuperAdmin();
    }

    // --- CUSTOMERS CRM COLLECTION ---
    match /customers/{customerId} {
      allow read: if isOwner(customerId) || isSupportManager() || isOrderManager() || isAdmin();
      allow create: if (
        isOwner(customerId) &&
        (!('uid' in request.resource.data) || request.resource.data.uid == request.auth.uid) &&
        !request.resource.data.keys().hasAny([
          'customerStatus', 'isBlocked', 'internalNotes', 'totalSpend', 'orderCount', 
          'ordersCount', 'totalSpent', 'roles', 'role', 'roleId', 'roleSlug', 'roleName',
          'departmentId', 'departmentName'
        ])
      ) || isSupportManager() || isAdmin();
      allow update: if isOwner(customerId)
        ? (!request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'customerStatus', 'isBlocked', 'internalNotes', 'totalSpend', 'orderCount', 
            'ordersCount', 'totalSpent', 'roles', 'role', 'uid', 'createdAt'
          ]))
        : (isSupportManager() || isAdmin());
      allow delete: if isSuperAdmin();

      // Protected CRM Internal Notes Subcollection (Customers CANNOT read/write notes)
      match /crmNotes/{noteId} {
        allow read, write: if isSupportManager() || isAdmin();
      }
    }

    // --- PRODUCTS COLLECTION ---
    match /products/{productId} {
      allow read: if true;
      allow write: if isCatalogManager();
    }

    // --- CATEGORIES COLLECTION ---
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isCatalogManager();
    }

    // --- CATEGORY CODES INDEX COLLECTION ---
    match /categoryCodes/{code} {
      allow read: if true;
      allow write: if isCatalogManager();
    }

    // --- COUNTERS COLLECTION (FOR SKU AUTO-INCREMENT) ---
    match /counters/{counterId} {
      allow read: if true;
      allow write: if isCatalogManager();
    }

    // --- COLLECTIONS COLLECTION ---
    match /collections/{collectionId} {
      allow read: if true;
      allow write: if isCatalogManager();
    }

    // --- ORDERS COLLECTION ---
    match /orders/{orderId} {
      allow read: if isOrderManager() || isSupportManager() || (isSignedIn() && resource.data.customerId == request.auth.uid);
      allow create: if (
        request.resource.data.keys().hasAll(['id', 'customerId', 'customerEmail', 'customerName', 'total', 'orderStatus']) &&
        request.resource.data.total is number && request.resource.data.total >= 0 &&
        request.resource.data.orderStatus == 'pending' &&
        (!('paymentStatus' in request.resource.data) || request.resource.data.paymentStatus in ['pending', 'paid']) &&
        (!isSignedIn() || request.resource.data.customerId == request.auth.uid)
      );
      allow update: if isOrderManager() || isAdmin() || (
        isSignedIn() && resource.data.customerId == request.auth.uid &&
        resource.data.orderStatus == 'pending' &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['cancellationRequested', 'cancellationReason', 'orderStatus', 'timeline', 'updatedAt']) &&
        request.resource.data.orderStatus == 'cancelled'
      );
      allow delete: if isSuperAdmin();
    }

    // --- CARTS COLLECTION ---
    match /carts/{customerId} {
      allow read, write: if isOwner(customerId) || isOrderManager();
    }

    // --- WISHLISTS COLLECTION ---
    match /wishlists/{customerId} {
      allow read, write: if isOwner(customerId) || isSupportManager();
    }

    // --- COUPONS COLLECTION ---
    match /coupons/{couponId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // --- REVIEWS COLLECTION ---
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if (
        (
          request.resource.data.keys().hasAll(['productId', 'rating']) &&
          request.resource.data.rating is number &&
          request.resource.data.rating >= 1 &&
          request.resource.data.rating <= 5 &&
          (!('comment' in request.resource.data) || (request.resource.data.comment is string && request.resource.data.comment.size() <= 5000)) &&
          (!('reviewText' in request.resource.data) || (request.resource.data.reviewText is string && request.resource.data.reviewText.size() <= 5000))
        ) || isSupportManager() || isAdmin()
      );
      allow update: if isSupportManager() || isAdmin() || isSuperAdmin();
      allow delete: if isSupportManager() || isAdmin() || isSuperAdmin();
    }

    // --- INQUIRIES COLLECTION ---
    match /inquiries/{inquiryId} {
      allow create: if request.resource.data.keys().hasAll(['email', 'name', 'message']) &&
        request.resource.data.email is string &&
        request.resource.data.name is string &&
        request.resource.data.message is string &&
        request.resource.data.message.size() <= 5000;
      allow read, update, delete: if isSupportManager() || isAdmin() || isSuperAdmin();
    }

    // --- AUDIT LOGS COLLECTION (IMMUTABLE RECORD) ---
    match /adminAuditLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isAdmin() || isCatalogManager() || isOrderManager() || isSupportManager();
      allow update, delete: if false; // Immutable audit log
    }

    match /audit_logs/{logId} {
      allow read: if isAdmin();
      allow create: if isAdmin() || isCatalogManager() || isOrderManager() || isSupportManager();
      allow update, delete: if false; // Immutable audit log
    }

    // --- STORE & SHIPPING SETTINGS ---
    match /storeSettings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /shippingSettings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // --- POLICY DOCUMENTS ---
    match /policyDocuments/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // --- ANNOUNCEMENTS COLLECTION ---
    match /announcements/{announcementId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // --- HERO BANNERS COLLECTION ---
    match /banners/{bannerId} {
      allow read: if true;
      allow write: if isAdmin() || isCatalogManager();
    }

    // --- NOTIFICATIONS ---
    match /notifications/{notificationId} {
      allow read: if isSignedIn() && (resource.data.recipientUid == request.auth.uid || isAdmin());
      allow write: if isAdmin();
    }

    // --- INVENTORY TRANSACTIONS ---
    match /inventoryTransactions/{transactionId} {
      allow read: if isCatalogManager() || isOrderManager() || isAdmin();
      allow create: if isCatalogManager() || isOrderManager() || isAdmin();
      allow update, delete: if false; // Immutable inventory log
    }

    // --- PRODUCT & CUSTOMER ACTIVITY ---
    match /productActivity/{activityId} {
      allow read: if isCatalogManager() || isAdmin();
      allow create: if isCatalogManager() || isAdmin();
      allow update, delete: if false;
    }

    match /customerActivity/{activityId} {
      allow read: if isSupportManager() || isAdmin();
      allow create: if isSupportManager() || isAdmin();
      allow update, delete: if false;
    }

    // --- EMAIL SETTINGS, CAMPAIGNS & SUPPRESSION ---
    match /emailSettings/{settingId} {
      allow read: if isAdmin();
      allow write: if isSuperAdmin();
    }

    match /emailCampaigns/{campaignId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    match /emailSuppressionList/{email} {
      allow read: if isAdmin();
      allow write: if true; // Public unsubscribe allowed to record suppression
    }

    match /emailTransactionalJobs/{jobId} {
      allow read: if isAdmin();
      allow write: if false; // Immutable server-only write via Admin SDK
    }

    match /emailDeliveryLogs/{logId} {
      allow read: if isAdmin();
      allow write: if false; // Immutable server-only write via Admin SDK
    }
  }
}

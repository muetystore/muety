{
  "name": "muety-store",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,json,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css,json,md}\"",
    "test": "vitest run",
    "build": "tsc && vite build",
    "check": "npm run typecheck && npm run lint",
    "preview": "vite preview",
    "firebase:setup": "node scripts/firebase/bootstrap.mjs",
    "firebase:status": "node scripts/firebase/status.mjs",
    "firebase:seed:dev": "node scripts/firebase/seed-firestore.mjs --dev",
    "seed:firebase": "node scripts/seed/seed-to-firebase.mjs"
  },
  "dependencies": {
    "canvas-confetti": "^1.9.4",
    "cloudinary": "^2.11.0",
    "firebase": "^10.14.1",
    "firebase-admin": "^14.5.0",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@firebase/rules-unit-testing": "^3.0.4",
    "@types/canvas-confetti": "^1.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@typescript-eslint/eslint-plugin": "^8.26.0",
    "@typescript-eslint/parser": "^8.26.0",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.21.0",
    "localtunnel": "^2.0.2",
    "prettier": "^3.5.3",
    "typescript": "~5.6.2",
    "typescript-eslint": "^8.71.0",
    "vite": "^6.0.1",
    "vitest": "^3.0.7"
  }
}

# ==============================================================================
# Netlify Redirects & Domain Rewrites Configuration for MUETY
# One Deployment Serving:
# - https://muety.in & www.muety.in (Countdown / Launch Gate)
# - https://store.muety.in          (Storefront SPA)
# - https://admin.muety.in          (Admin Panel SPA)
# ==============================================================================

# 1. API & Netlify Functions
/api/newsletter/subscribe       /.netlify/functions/subscribe            200
/api/launch-status              /.netlify/functions/launch-status         200
/api/media/cloudinary-signature /.netlify/functions/cloudinary-signature 200
/api/cloudinary/sign            /.netlify/functions/cloudinary-signature 200
/api/media/cloudinary-delete    /.netlify/functions/cloudinary-delete    200
/api/cloudinary/delete          /.netlify/functions/cloudinary-delete    200

# 2. Countdown & Legal Document Rewrites
/terms-and-conditions        /terms-and-conditions.html       200
/privacy-policy              /privacy-policy.html             200
/countdown                   /countdown.html                  200!
/countdown.html              /countdown.html                  200

# 3. Domain-Specific Hostname Routing
# Apex domain pre-launch: serves Countdown on root
https://muety.in/            /countdown.html                  200!
https://www.muety.in/        /countdown.html                  200!

# Admin subdomain API routes (must precede Admin SPA wildcard)
https://admin.muety.in/api/newsletter/subscribe       /.netlify/functions/subscribe            200
https://admin.muety.in/api/launch-status              /.netlify/functions/launch-status         200
https://admin.muety.in/api/media/cloudinary-signature /.netlify/functions/cloudinary-signature 200
https://admin.muety.in/api/cloudinary/sign            /.netlify/functions/cloudinary-signature 200
https://admin.muety.in/api/media/cloudinary-delete    /.netlify/functions/cloudinary-delete    200
https://admin.muety.in/api/cloudinary/delete          /.netlify/functions/cloudinary-delete    200

# Admin subdomain: serves Admin SPA entry point
https://admin.muety.in/*     /index.html                      200

# Storefront subdomain API routes
https://store.muety.in/api/newsletter/subscribe       /.netlify/functions/subscribe            200
https://store.muety.in/api/launch-status              /.netlify/functions/launch-status         200
https://store.muety.in/api/media/cloudinary-signature /.netlify/functions/cloudinary-signature 200
https://store.muety.in/api/cloudinary/sign            /.netlify/functions/cloudinary-signature 200
https://store.muety.in/api/media/cloudinary-delete    /.netlify/functions/cloudinary-delete    200
https://store.muety.in/api/cloudinary/delete          /.netlify/functions/cloudinary-delete    200

# Storefront subdomain: serves Storefront SPA entry point
https://store.muety.in/*     /index.html                      200

# POST-LAUNCH MIGRATION RULE (Uncomment after launch if 301 redirecting store.muety.in to muety.in):
# https://store.muety.in/*   https://muety.in/:splat          301!

# 4. Global Single Page Application (SPA) Fallback
/*                           /index.html                      200

# ==============================================================================
# MUETY Launch Gateway & Newsletter Configuration Example
# ==============================================================================

# Centralized Official Launch Timestamp (IST / Asia/Kolkata UTC+05:30)
LAUNCH_DATE=2026-10-18T08:00:00+05:30

# Launch Gate Mode: production | preview (forces live for testing) | force_prelaunch
MUETY_LAUNCH_MODE=production

# Canonical Store Destination URL (e.g. https://store.muety.in or leave blank for local /store)
MUETY_STORE_URL=https://store.muety.in

# Google Sheets Web App Endpoint for Newsletter Storage
GOOGLE_SHEETS_WEBHOOK_URL=https://script.google.com/macros/s/YOUR_GOOGLE_APPS_SCRIPT_DEPLOYMENT_ID/exec
